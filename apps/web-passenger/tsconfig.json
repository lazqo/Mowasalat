{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ]
}
